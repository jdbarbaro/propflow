# ─── Gmail API ───────────────────────────────────────────────────────────────
# The Gmail address to monitor (e.g. propmanager@yourcompany.com)
# The service account must be granted domain-wide delegation for this address.
GMAIL_USER_EMAIL=

# ─── Anthropic API ───────────────────────────────────────────────────────────
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use — defaults to claude-haiku-4-5-20251001 if not set
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Google Sheets API ───────────────────────────────────────────────────────
# Path to your service account JSON key file (relative to project root)
# The same service account is used for both Gmail and Sheets access.
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# Name of the specific tab/sheet to write rows into
GOOGLE_SHEET_NAME=Tenant Requests

# Phase 2 — tab names for routing lookups (defaults match if left blank)
GOOGLE_BUILDINGS_SHEET=Buildings
GOOGLE_VENDORS_SHEET=Vendors

# Phase 2B — Google Drive folder path containing management agreement PDFs
PROPFLOW_DRIVE_FOLDER=PropFlow/Management Agreements
